// ============================================================
// Multi-Vendor E-Commerce Platform - Prisma Schema
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "darwin", "darwin-arm64", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  CUSTOMER
  ADMIN
  SHIPPER
}

enum ShopStatus {
  PENDING
  ACTIVE
  REJECTED
  BANNED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
}

enum ShopOrderStatus {
  PENDING
  PREPARING
  READY_FOR_PICKUP
  SHIPPING
  DELIVERED
  CANCELLED
}

enum ChatSessionStatus {
  ACTIVE
  CLOSED
  ESCALATED
}

enum SenderType {
  USER
  BOT
  SHOP
}

enum InteractionType {
  VIEW
  ADD_TO_CART
  PURCHASE
}

// ==================== 1. USER & AUTH ====================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  full_name     String
  phone         String   @unique
  role          UserRole @default(CUSTOMER)
  is_banned     Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  addresses       UserAddress[]
  shops           Shop[]
  parent_orders   ParentOrder[]
  tracking_events TrackingEvent[]
  reviews         Review[]
  chat_sessions   ChatSession[]
  interactions    UserInteraction[]
  wishlist        Wishlist[]
  coupon_usages   CouponUsage[]

  @@map("users")
}

model UserAddress {
  id           String  @id @default(uuid()) @db.Uuid
  user_id      String  @db.Uuid
  address_line String
  ward         String
  district     String
  city         String
  is_default   Boolean @default(false)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

// ==================== 2. SHOP / VENDOR ====================

model Shop {
  id          String     @id @default(uuid()) @db.Uuid
  owner_id    String     @db.Uuid
  name        String
  description String?    @db.Text
  logo_url    String?
  rating      Decimal    @default(0) @db.Decimal(3, 2)
  status      ShopStatus @default(PENDING)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  owner         User          @relation(fields: [owner_id], references: [id])
  products      Product[]
  shop_orders   ShopOrder[]
  chat_sessions ChatSession[]
  coupons       Coupon[]

  @@map("shops")
}

// ==================== 3. PRODUCT & CATEGORY ====================

model Category {
  id        Int     @id @default(autoincrement())
  name      String
  slug      String  @unique
  parent_id Int?

  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  shop_id        String   @db.Uuid
  category_id    Int
  name           String
  slug           String   @unique
  description    String?  @db.Text
  meta_title     String?  @db.Text
  meta_description String? @db.Text
  price          Decimal  @db.Decimal(12, 2)
  stock_quantity Int      @default(0)
  sales_count    Int      @default(0)
  images         String[] @default([])
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  shop         Shop              @relation(fields: [shop_id], references: [id])
  category     Category          @relation(fields: [category_id], references: [id])
  order_items  OrderItem[]
  interactions UserInteraction[]
  reviews      Review[]
  wishlist     Wishlist[]

  @@map("products")
}

// ==================== 4. ORDER & ORDER SPLITTING ====================

model ParentOrder {
  id               String        @id @default(uuid()) @db.Uuid
  user_id          String        @db.Uuid
  total_payment    Decimal       @db.Decimal(12, 2)
  payment_status   PaymentStatus @default(UNPAID)
  payment_method   PaymentMethod
  shipping_address String        @db.Text
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  user        User        @relation(fields: [user_id], references: [id])
  shop_orders ShopOrder[]

  @@map("parent_orders")
}

model ShopOrder {
  id              String          @id @default(uuid()) @db.Uuid
  parent_order_id String          @db.Uuid
  shop_id         String          @db.Uuid
  shipping_fee    Decimal         @default(0) @db.Decimal(10, 2)
  status          ShopOrderStatus @default(PENDING)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  parent_order    ParentOrder     @relation(fields: [parent_order_id], references: [id])
  shop            Shop            @relation(fields: [shop_id], references: [id])
  order_items     OrderItem[]
  tracking_events TrackingEvent[]

  @@map("shop_orders")
}

model OrderItem {
  id                String  @id @default(uuid()) @db.Uuid
  shop_order_id     String  @db.Uuid
  product_id        String  @db.Uuid
  quantity          Int
  price_at_purchase Decimal @db.Decimal(12, 2)

  shop_order ShopOrder @relation(fields: [shop_order_id], references: [id])
  product    Product   @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

// ==================== 5. LOGISTICS & TRACKING ====================

model TrackingEvent {
  id            String   @id @default(uuid()) @db.Uuid
  shop_order_id String   @db.Uuid
  shipper_id    String?  @db.Uuid
  event_type    String   // order_packed, picked_up, arrived_at_hub, delivering, delivered
  location      String?
  proof_image   String?  @db.Text
  created_at    DateTime @default(now())

  shop_order ShopOrder @relation(fields: [shop_order_id], references: [id])
  shipper    User?     @relation(fields: [shipper_id], references: [id])

  @@map("tracking_events")
}

// ==================== 6. REVIEWS ====================

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  rating     Int
  comment    String?  @db.Text
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@map("reviews")
}

// ==================== 7. COUPON ====================

enum CouponType {
  PERCENTAGE   // Giảm theo %
  FIXED_AMOUNT // Giảm số tiền cố định
}

model Coupon {
  id               String     @id @default(uuid()) @db.Uuid
  code             String     @unique
  shop_id          String?    @db.Uuid
  type             CouponType @default(PERCENTAGE)
  value            Decimal    @db.Decimal(12, 2)  // % hoặc số tiền giảm
  min_order_amount Decimal?   @db.Decimal(12, 2)  // Điều kiện đơn tối thiểu
  max_discount     Decimal?   @db.Decimal(12, 2)  // Trần giảm giá (cho loại %)
  usage_limit      Int?                            // Số lần dùng tối đa
  used_count       Int        @default(0)          // Số lần đã dùng
  expires_at       DateTime?                       // Hạn sử dụng
  is_active        Boolean    @default(true)
  created_at       DateTime   @default(now())

  shop             Shop?      @relation(fields: [shop_id], references: [id])
  usages           CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id         String   @id @default(uuid()) @db.Uuid
  coupon_id  String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now())

  coupon     Coupon   @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([coupon_id, user_id])
  @@map("coupon_usages")
}

// ==================== 8. WISHLIST ====================

model Wishlist {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@map("wishlists")
}

// ==================== 6. AI CHATBOT & RECOMMENDATION ====================

model ChatSession {
  id         String            @id @default(uuid()) @db.Uuid
  user_id    String?           @db.Uuid
  shop_id    String?           @db.Uuid
  status     ChatSessionStatus @default(ACTIVE)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  user     User?         @relation(fields: [user_id], references: [id])
  shop     Shop?         @relation(fields: [shop_id], references: [id])
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id              String     @id @default(uuid()) @db.Uuid
  session_id      String     @db.Uuid
  sender_type     SenderType
  message_text    String     @db.Text
  intent_detected String?
  created_at      DateTime   @default(now())

  session ChatSession @relation(fields: [session_id], references: [id])

  @@map("chat_messages")
}

model UserInteraction {
  id               String          @id @default(uuid()) @db.Uuid
  user_id          String          @db.Uuid
  product_id       String          @db.Uuid
  interaction_type InteractionType
  created_at       DateTime        @default(now())

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@map("user_interactions")
}
